@{
    ViewBag.Title = "Giao hàng & ưu đãi vận chuyển · MAISONÉ";
    ViewBag.BodyClass = "service-page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="announcement">
    MAISONÉ · GIAO HÀNG TOÀN QUỐC
</div>


<header class="header">

    <div class="header-inner">

        <nav class="left-nav">

            <a class="nav-link"
               href="@Url.Action("Index", "Home")">
                TRANG CHỦ
            </a>

            <a class="nav-link"
               href="@Url.Action("Index", "Products")">
                BỘ SƯU TẬP
            </a>

            <a class="nav-link"
               href="@Url.Action("Support", "Service")">
                HỖ TRỢ
            </a>

        </nav>


        <button class="mobile-button"
                type="button"
                onclick="toggleMobileMenu()"
                aria-label="Mở menu">

            <i class="fa-solid fa-bars"></i>

        </button>


        <a class="logo"
           href="@Url.Action("Index", "Home")">

            MAISONÉ

            <span class="logo-sub">
                FASHION BAGS
            </span>

        </a>


        <nav class="right-nav">

            <a class="nav-link"
               href="@Url.Action("Login", "Account")">

                <i class="fa-regular fa-user"></i>

            </a>


            <a class="header-icon"
               href="@Url.Action("Index", "Cart")">

                <i class="fa-solid fa-bag-shopping"></i>

                <span class="cart-number"
                      id="cartNumber">
                    0
                </span>

            </a>

        </nav>

    </div>

</header>


<!-- =========================
     MOBILE MENU
     ========================= -->

<nav class="mobile-menu"
     id="mobileMenu"
     aria-label="Menu mobile">

    <a href="@Url.Action("Index", "Home")">
        TRANG CHỦ
    </a>

    <a href="@Url.Action("Index", "Products")">
        BỘ SƯU TẬP
    </a>

    <a href="@Url.Action("Support", "Service")">
        HỖ TRỢ
    </a>

    <a href="@Url.Action("Index", "Cart")">
        GIỎ HÀNG
    </a>

</nav>


<main class="page-shell service-shell">


    <!-- =========================
         BREADCRUMB
         ========================= -->

    <div class="service-breadcrumb">

        <a href="@Url.Action("Index", "Home")">
            Trang chủ
        </a>

        <span>/</span>

        <span>
            Giao hàng
        </span>

    </div>


    <!-- =========================
         SERVICE HERO
         ========================= -->

    <section class="service-hero">

        <span class="eyebrow">
            DELIVERY &amp; SHIPPING
        </span>

        <h1 class="page-title">
            Giao hàng rõ ràng,<br>
            <em>nhận túi an tâm.</em>
        </h1>

        <p>
            Chọn ưu đãi vận chuyển ngay tại giỏ hàng
            và xem phí giao hàng trước khi xác nhận đơn.
        </p>


        <!-- SHIPPING PROMO -->

        <div class="shipping-promo">

            <div class="shipping-promo-icon">

                <i class="fa-solid fa-truck-fast"></i>

            </div>


            <div>

                <span>
                    MÃ ƯU ĐÃI VẬN CHUYỂN
                </span>

                <strong>
                    FREESHIP
                </strong>

                <small>
                    Miễn phí giao hàng cho đơn từ 999.000đ.
                    Không áp dụng đồng thời với mã giảm giá
                    sản phẩm khác.
                </small>

                <small>
                    Hiệu lực: 01/10/2026 – 31/10/2026
                </small>

            </div>


            <a class="ui-btn"
               href="@Url.Action("Index", "Cart")?coupon=FREESHIP">

                DÙNG MÃ Ở GIỎ HÀNG →

            </a>

        </div>

    </section>


    <!-- =========================
         SHIPPING VOUCHERS
         ========================= -->

    <section class="shipping-voucher-section">

        <div class="catalog-heading">

            <div>

                <span class="eyebrow">
                    DELIVERY REWARDS
                </span>

                <h2>
                    Voucher vận chuyển
                </h2>

                <p>
                    Lưu mã trước, áp dụng cho đơn hàng
                    đủ điều kiện tại giỏ.
                </p>

            </div>


            <a class="text-link"
               href="@Url.Action("Index", "Cart")">

                ĐẾN GIỎ HÀNG

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>


        <!-- shipping.js render voucher tại đây -->

        <div class="shipping-voucher-grid"
             id="shippingVouchers">
        </div>

    </section>


    <!-- =========================
         SHIPPING INFORMATION
         ========================= -->

    <section class="service-content-grid">


        <!-- 01 -->

        <article class="service-card">

            <span class="service-step">
                01
            </span>

            <h2>
                Phí giao hàng
            </h2>

            <p>
                Đơn hàng dưới 999.000đ:
                phí giao hàng demo 30.000đ.
                Đơn từ 999.000đ:
                nhập mã <strong>FREESHIP</strong>
                trong giỏ hàng để được miễn phí vận chuyển.
            </p>

        </article>


        <!-- 02 -->

        <article class="service-card">

            <span class="service-step">
                02
            </span>

            <h2>
                Thời gian dự kiến
            </h2>

            <p>
                Nội thành: 1–3 ngày làm việc.
                Các tỉnh thành khác:
                2–5 ngày làm việc sau khi xác nhận đơn.
            </p>

        </article>


        <!-- 03 -->

        <article class="service-card">

            <span class="service-step">
                03
            </span>

            <h2>
                Theo dõi đơn hàng
            </h2>

            <p>
                Vào lịch sử đơn hàng để xem trạng thái.
                Nếu cần cập nhật địa chỉ hoặc thời gian nhận,
                hãy nhắn bộ phận hỗ trợ trước khi đơn được
                bàn giao cho đơn vị giao hàng.
            </p>


            <a class="text-link"
               href="@Url.Action("Index", "Orders")">

                XEM ĐƠN HÀNG

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </article>

    </section>


    <!-- =========================
         FOOTER ACTIONS
         ========================= -->

    <div class="service-footer-actions">

        <a class="ui-btn"
           href="@Url.Action("Index", "Products")">

            TIẾP TỤC MUA SẮM

        </a>


        <a class="ui-btn light"
           href="@Url.Action("Support", "Service")">

            HỎI VỀ ĐƠN GIAO HÀNG

        </a>

    </div>


    <p class="demo-disclaimer">

        Thông tin giao hàng và phí vận chuyển đang mô phỏng
        ở frontend, chưa kết nối đơn vị vận chuyển.

    </p>

</main>


<div id="toast"
     class="toast"
     role="status"
     aria-live="polite">
</div>


@section Scripts {

    <script src="@Url.Content("~/Scripts/Java/shipping.js")"></script>

}