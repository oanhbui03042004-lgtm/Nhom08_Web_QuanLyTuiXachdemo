@{
    ViewBag.Title = "Bảo hành & gửi yêu cầu · MAISONÉ";
}

<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Bảo hành & gửi yêu cầu · MAISONÉ</title>

    <link rel="stylesheet" href="~/Content/css/style.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body class="service-page">

    <div class="announcement">
        MAISONÉ · CHĂM SÓC SẢN PHẨM
    </div>


    <!-- HEADER -->
    <header class="header">

        <div class="header-inner">

            <nav class="left-nav">

                <a class="nav-link"
                   href="@Url.Action("Index", "Home")">
                    TRANG CHỦ
                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "Products")">
                    BỘ SƯU TẬP
                </a>

                <a class="nav-link"
                   href="@Url.Action("Support", "Service")">
                    HỖ TRỢ
                </a>

            </nav>


            <button class="mobile-button"
                    type="button"
                    onclick="toggleMobileMenu()"
                    aria-label="Mở menu">

                <i class="fa-solid fa-bars"></i>

            </button>


            <a class="logo"
               href="@Url.Action("Index", "Home")">

                MAISONÉ

                <span class="logo-sub">
                    FASHION BAGS
                </span>

            </a>


            <nav class="right-nav">

                <a class="nav-link"
                   href="@Url.Action("Index", "Orders")">
                    ĐƠN HÀNG
                </a>

                <a class="header-icon"
                   href="@Url.Action("Index", "Cart")">

                    <i class="fa-solid fa-bag-shopping"></i>

                    <span class="cart-number"
                          id="cartNumber">
                        0
                    </span>

                </a>

            </nav>

        </div>

    </header>


    <!-- MOBILE MENU -->
    <nav class="mobile-menu"
         id="mobileMenu"
         aria-label="Menu mobile">

        <a href="@Url.Action("Index", "Home")">
            TRANG CHỦ
        </a>

        <a href="@Url.Action("Index", "Products")">
            BỘ SƯU TẬP
        </a>

        <a href="@Url.Action("Index", "Orders")">
            ĐƠN HÀNG
        </a>

        <a href="@Url.Action("Support", "Service")">
            HỖ TRỢ
        </a>

    </nav>


    <main class="page-shell service-shell">

        <!-- BREADCRUMB -->
        <div class="service-breadcrumb">

            <a href="@Url.Action("Index", "Home")">
                Trang chủ
            </a>

            <span>/</span>

            <span>Bảo hành</span>

        </div>


        <!-- HERO -->
        <section class="service-hero">

            <span class="eyebrow">
                MAISONÉ PRODUCT CARE
            </span>

            <h1 class="page-title">
                Bảo hành 1 năm,<br>
                <em>gửi yêu cầu ngay tại đây.</em>
            </h1>

            <p>
                Gửi thông tin đơn hàng và tình trạng sản phẩm.
                Nhân viên sẽ kiểm tra điều kiện bảo hành
                và hướng dẫn bạn.
            </p>

        </section>


        <!-- TWO COLUMN -->
        <div class="service-two-column">

            <!-- FORM BẢO HÀNH -->
            <section class="service-card">

                <h2>
                    <i class="fa-solid fa-shield-halved"></i>
                    Đăng ký kiểm tra bảo hành
                </h2>


                <form id="warrantyForm"
                      class="service-form">

                    <label for="warrantyOrder">
                        Mã đơn hàng *
                    </label>

                    <input id="warrantyOrder"
                           name="order"
                           required
                           placeholder="Ví dụ: MS-260815">


                    <label for="warrantyProduct">
                        Sản phẩm *
                    </label>

                    <select id="warrantyProduct"
                            name="product"
                            required>

                        <option value="">
                            Chọn sản phẩm
                        </option>

                        <option>
                            Ava Shoulder Bag
                        </option>

                        <option>
                            Léa Mini Bag
                        </option>

                        <option>
                            Mila Classic
                        </option>

                        <option>
                            Elora Tote
                        </option>

                        <option>
                            Sản phẩm khác
                        </option>

                    </select>


                    <label for="warrantyReason">
                        Mô tả lỗi / tình trạng cần hỗ trợ *
                    </label>

                    <textarea id="warrantyReason"
                              name="reason"
                              rows="4"
                              required
                              placeholder="Mô tả vị trí hỏng, thời điểm phát hiện và cách sử dụng gần đây"></textarea>


                    <label for="warrantyPhotos">
                        Ảnh minh chứng
                        (tối đa 3 ảnh, JPG/PNG/WEBP) *
                    </label>


                    <label class="service-file-picker"
                           for="warrantyPhotos">

                        <i class="fa-solid fa-cloud-arrow-up"></i>

                        CHỌN ẢNH MINH CHỨNG

                        <input id="warrantyPhotos"
                               name="photos"
                               type="file"
                               accept="image/jpeg,image/png,image/webp"
                               multiple
                               required>

                    </label>


                    <span class="service-file-names"
                          id="warrantyPhotoNames">
                        Chưa chọn ảnh nào.
                    </span>


                    <div class="warranty-photo-preview"
                         id="warrantyPhotoPreview"
                         aria-live="polite">
                    </div>


                    <small class="service-file-note">
                        Ảnh giúp nhân viên kiểm tra tình trạng
                        trước khi hướng dẫn gửi sản phẩm.
                    </small>


                    <label for="warrantyPhone">
                        Số điện thoại liên hệ *
                    </label>

                    <input id="warrantyPhone"
                           name="phone"
                           type="tel"
                           inputmode="tel"
                           pattern="[0-9+ ]{8,18}"
                           required
                           placeholder="0909 123 456">


                    <button class="ui-btn"
                            type="submit">
                        GỬI YÊU CẦU BẢO HÀNH →
                    </button>

                </form>

            </section>


            <!-- QUYỀN LỢI + QUY TRÌNH -->
            <aside class="service-card service-steps">

                <h2>
                    Quyền lợi & quy trình
                </h2>

                <p>
                    Bảo hành tối đa 12 tháng cho lỗi kỹ thuật
                    phát sinh trong điều kiện sử dụng bình thường.
                    Nhân viên sẽ xác nhận phạm vi áp dụng sau
                    khi kiểm tra sản phẩm.
                </p>


                <ol>

                    <li>
                        <strong>Gửi thông tin</strong>
                        <span>
                            Nhập mã đơn và mô tả lỗi.
                        </span>
                    </li>

                    <li>
                        <strong>Nhân viên liên hệ</strong>
                        <span>
                            Tra cứu lịch sử mua và hướng dẫn kiểm tra.
                        </span>
                    </li>

                    <li>
                        <strong>Tiếp nhận sản phẩm</strong>
                        <span>
                            Gửi sản phẩm sau khi có hướng dẫn tiếp nhận.
                        </span>
                    </li>

                    <li>
                        <strong>Cập nhật kết quả</strong>
                        <span>
                            Theo dõi phản hồi trong danh sách yêu cầu bên dưới.
                        </span>
                    </li>

                </ol>


                <a class="text-link"
                   href="@Url.Action("Support", "Service")">

                    CẦN TƯ VẤN? NHẮN TIN HỖ TRỢ

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </aside>

        </div>


        <!-- DANH SÁCH YÊU CẦU -->
        <section class="service-card service-request-list">

            <h2>
                Yêu cầu bảo hành đã gửi trên thiết bị này
            </h2>

            <div id="warrantyRequests">
            </div>

        </section>


        <!-- FOOTER ACTIONS -->
        <div class="service-footer-actions">

            <a class="ui-btn"
               href="@Url.Action("Index", "Products")">
                TIẾP TỤC MUA SẮM
            </a>

            <a class="ui-btn light"
               href="@Url.Action("Index", "Orders")">
                XEM LỊCH SỬ ĐƠN
            </a>

            <a class="ui-btn light"
               href="@Url.Action("Vouchers", "Service")">
                HẠNG THÀNH VIÊN
            </a>

        </div>


        <p class="demo-disclaimer">
            Đây là luồng giao diện demo: yêu cầu được lưu trong
            trình duyệt hiện tại, chưa kết nối hệ thống bảo hành.
        </p>

    </main>


    <!-- TOAST -->
    <div id="toast"
         class="toast"
         role="status"
         aria-live="polite">
    </div>


    <!-- JAVASCRIPT -->
    <script src="~/Scripts/Java/data.js"></script>
    <script src="~/Scripts/Java/common.js"></script>
    <script src="~/Scripts/Java/service.js"></script>

</body>
</html>