@{
    ViewBag.Title = "Tất cả sản phẩm · MAISONÉ";
}

<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Tất cả sản phẩm · MAISONÉ</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet"
          href="~/Content/css/style.css">
</head>


<body class="collection-page">

    <!-- ANNOUNCEMENT -->
    <div class="announcement">
        MAISONÉ · MIỄN PHÍ VẬN CHUYỂN CHO ĐƠN TỪ 999.000Đ
    </div>


    <!-- HEADER -->
    <header class="header storefront-header">

        <div class="header-inner">

            <!-- LEFT NAV -->
            <nav class="left-nav"
                 aria-label="Điều hướng chính">

                <a class="nav-link"
                   href="@Url.Action("Index", "Home")">
                    TRANG CHỦ
                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "Products")">
                    TẤT CẢ TÚI
                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "Home")#seasonCollections">
                    BỘ SƯU TẬP
                </a>

                <a class="nav-link"
                   href="@Url.Action("Shipping", "Service")">
                    VẬN CHUYỂN
                </a>

                <a class="nav-link"
                   href="@Url.Action("Support", "Service")">
                    HỖ TRỢ
                </a>

            </nav>


            <!-- MOBILE BUTTON -->
            <button class="mobile-button"
                    type="button"
                    onclick="toggleMobileMenu()"
                    aria-label="Mở menu">

                <i class="fa-solid fa-bars"></i>

            </button>


            <!-- LOGO -->
            <a class="logo"
               href="@Url.Action("Index", "Home")">

                MAISONÉ

                <span class="logo-sub">
                    BAGS & ACCESSORIES
                </span>

            </a>


            <!-- RIGHT NAV -->
            <nav class="right-nav"
                 aria-label="Tài khoản và mua sắm">

                <!-- WISHLIST -->
                <a class="header-icon"
                   href="@Url.Action("Index", "Wishlist")"
                   aria-label="Sản phẩm yêu thích">

                    <i class="fa-regular fa-heart"></i>

                </a>


                <!-- ACCOUNT -->
                <a class="account-button"
                   href="@Url.Action("Login", "Account")">

                    <i class="fa-regular fa-user"></i>

                    <span>
                        TÀI KHOẢN
                    </span>

                </a>


                <!-- CART -->
                <a class="header-icon"
                   href="@Url.Action("Index", "Cart")"
                   aria-label="Giỏ hàng">

                    <i class="fa-solid fa-bag-shopping"></i>

                    <span class="cart-number"
                          id="cartNumber">
                        0
                    </span>

                </a>

            </nav>

        </div>

    </header>


    <!-- MOBILE MENU -->
    <nav class="mobile-menu"
         id="mobileMenu"
         aria-label="Menu mua sắm">

        <a href="@Url.Action("Index", "Home")">
            TRANG CHỦ
        </a>

        <a href="@Url.Action("Index", "Products")">
            TẤT CẢ TÚI
        </a>

        <a href="@Url.Action("Index", "Home")#seasonCollections">
            BỘ SƯU TẬP
        </a>

        <a href="@Url.Action("Shipping", "Service")">
            VẬN CHUYỂN
        </a>

        <a href="@Url.Action("Support", "Service")">
            HỖ TRỢ
        </a>

    </nav>


    <!-- MAIN -->
    <main class="page-shell collection-shell">


        <!-- BREADCRUMB -->
        <div class="service-breadcrumb">

            <a href="@Url.Action("Index", "Home")">
                Trang chủ
            </a>

            <span>/</span>

            <span>
                Tất cả sản phẩm
            </span>

        </div>


        <!-- CATALOG HERO -->
        <section class="catalog-hero">

            <div>

                <span class="eyebrow">
                    MAISONÉ COLLECTION
                </span>

                <h1>
                    Chiếc túi dành<br>
                    <em>cho câu chuyện của bạn.</em>
                </h1>

                <p>
                    Tìm thiết kế phù hợp với nhịp sống,
                    phong cách và những điều bạn muốn mang theo.
                </p>

                <a class="ui-btn catalog-hero-button"
                   href="#allProducts">

                    KHÁM PHÁ SẢN PHẨM

                    <i class="fa-solid fa-arrow-down"></i>

                </a>

            </div>


            <div class="catalog-hero-image"
                 role="img"
                 aria-label="Bộ sưu tập túi Maisoné">
            </div>

        </section>


        <!-- COLLECTION -->
        <section class="catalog-season-section">

            <div class="catalog-heading">

                <div>

                    <span class="eyebrow">
                        CURATED FOR YOUR DAYS
                    </span>

                    <h2>
                        Chọn bộ sưu tập
                    </h2>

                </div>


                <a class="text-link"
                   href="@Url.Action("Index", "Home")#seasonCollections">

                    XEM THÊM TẠI TRANG CHỦ

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


            <div class="catalog-season-links"
                 aria-label="Bộ sưu tập theo mùa">


                <!-- AUTUMN -->
                <a href="@Url.Action("Autumn", "Collection")">

                    <span>
                        01 / THU ĐÔNG
                    </span>

                    <strong>
                        Gam màu trầm ấm

                        <i class="fa-solid fa-arrow-right"></i>
                    </strong>

                </a>


                <!-- SUMMER -->
                <a href="@Url.Action("Summer", "Collection")">

                    <span>
                        02 / MÙA HÈ
                    </span>

                    <strong>
                        Nhẹ nhàng cho chuyến đi

                        <i class="fa-solid fa-arrow-right"></i>
                    </strong>

                </a>


                <!-- WORK -->
                <a href="@Url.Action("Work", "Collection")">

                    <span>
                        03 / CÔNG SỞ
                    </span>

                    <strong>
                        Chỉn chu mỗi ngày

                        <i class="fa-solid fa-arrow-right"></i>
                    </strong>

                </a>


                <!-- WEEKEND -->
                <a href="@Url.Action("Weekend", "Collection")">

                    <span>
                        04 / DẠO PHỐ
                    </span>

                    <strong>
                        Nhỏ xinh tự do

                        <i class="fa-solid fa-arrow-right"></i>
                    </strong>

                </a>

            </div>

        </section>


        <!-- ALL PRODUCTS -->
        <section class="catalog-products"
                 id="allProducts">


            <!-- HEADING -->
            <div class="catalog-heading">

                <div>

                    <span class="eyebrow">
                        FIND YOUR EVERYDAY ICON
                    </span>

                    <h2>
                        Tất cả sản phẩm
                    </h2>

                </div>


                <span class="catalog-count"
                      id="catalogCount">
                </span>

            </div>


            <!-- TOOLBAR -->
            <div class="catalog-toolbar">


                <!-- SEARCH -->
                <label class="catalog-search">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input id="searchInput"
                           type="search"
                           placeholder="Tìm tên túi..."
                           aria-label="Tìm tên túi">

                </label>


                <!-- FILTER -->
                <div class="filter"
                     aria-label="Lọc loại túi">

                    <button class="active"
                            data-cat="all">

                        TẤT CẢ

                    </button>

                    <button data-cat="Shoulder">
                        SHOULDER
                    </button>

                    <button data-cat="Tote">
                        TOTE
                    </button>

                    <button data-cat="Mini">
                        MINI
                    </button>

                    <button data-cat="Office">
                        OFFICE
                    </button>

                </div>

            </div>


            <!-- PRODUCTS -->
            <div id="products"
                 class="product-grid catalog-grid">
            </div>

        </section>

    </main>


    <!-- FOOTER -->
    <footer class="storefront-footer">

        <div class="footer-grid">


            <!-- BRAND -->
            <div>

                <div class="footer-brand">
                    MAISONÉ
                </div>

                <p class="footer-description">
                    Những thiết kế túi xách thanh lịch
                    cho nhịp sống hiện đại.
                </p>

            </div>


            <!-- SHOPPING -->
            <div class="footer-column">

                <h4>
                    MUA SẮM
                </h4>

                <a href="@Url.Action("Index", "Products")">
                    Tất cả sản phẩm
                </a>

                <a href="@Url.Action("Index", "Cart")">
                    Giỏ hàng
                </a>

                <a href="@Url.Action("Index", "Wishlist")">
                    Yêu thích
                </a>

            </div>


            <!-- POLICY -->
            <div class="footer-column">

                <h4>
                    CHÍNH SÁCH
                </h4>

                <a href="@Url.Action("Shipping", "Service")">
                    Giao hàng
                </a>

                <a href="@Url.Action("Returns", "Service")">
                    Đổi trả
                </a>

                <a href="@Url.Action("Warranty", "Service")">
                    Bảo hành
                </a>

            </div>


            <!-- CONTACT -->
            <div class="footer-column">

                <h4>
                    LIÊN HỆ
                </h4>

                <a href="@Url.Action("Support", "Service")">
                    Trung tâm hỗ trợ
                </a>

                <a href="tel:0909123456">
                    0909 123 456
                </a>

            </div>

        </div>


        <!-- FOOTER BOTTOM -->
        <div class="footer-bottom">

            <span>
                © 2026 MAISONÉ. ALL RIGHTS RESERVED.
            </span>

            <span>
                MADE WITH LOVE ♡
            </span>

        </div>

    </footer>


    <!-- TOAST -->
    <div id="toast"
         class="toast"
         role="status"
         aria-live="polite">
    </div>


    <!-- JAVASCRIPT -->


    <script>
        window.mvcRoot = '@Url.Content("~/")';
        const productDetailUrl = '@Url.Action("Detail", "Products")';
    </script>

    <script src="~/Scripts/Java/data.js"></script>

    <script src="~/Scripts/Java/common.js"></script>

    <script src="~/Scripts/Java/products.js"></script>

</body>
</html>

