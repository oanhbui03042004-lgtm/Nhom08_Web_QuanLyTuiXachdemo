@{
    ViewBag.Title = "Chi tiết sản phẩm · MAISONÉ";
}

<!doctype html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Chi tiết sản phẩm · MAISONÉ</title>


    <!-- GOOGLE FONT -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
          rel="stylesheet">


    <!-- FONT AWESOME -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <!-- CSS -->
    <link rel="stylesheet"
          href="~/Content/css/style.css">

</head>


<body class="detail-page">


    <!-- ANNOUNCEMENT -->
    <div class="announcement">
        MAISONÉ · THIẾT KẾ TINH TẾ, ĐỒNG HÀNH DÀI LÂU
    </div>



    <!-- HEADER -->
    <header class="header storefront-header">

        <div class="header-inner">


            <!-- LEFT NAV -->
            <nav class="left-nav">

                <a class="nav-link"
                   href="@Url.Action("Index", "Home")">

                    TRANG CHỦ

                </a>


                <a class="nav-link"
                   href="@Url.Action("Index", "Products")">

                    TẤT CẢ TÚI

                </a>

            </nav>



            <!-- MOBILE BUTTON -->
            <button class="mobile-button"
                    type="button"
                    onclick="toggleMobileMenu()"
                    aria-label="Mở menu">

                <i class="fa-solid fa-bars"></i>

            </button>



            <!-- LOGO -->
            <a class="logo"
               href="@Url.Action("Index", "Home")">

                MAISONÉ

                <span class="logo-sub">
                    BAGS & ACCESSORIES
                </span>

            </a>



            <!-- RIGHT NAV -->
            <nav class="right-nav">


                <!-- ACCOUNT -->
                <a class="account-button"
                   href="@Url.Action("Login", "Account")">

                    <i class="fa-regular fa-user"></i>

                    <span>
                        TÀI KHOẢN
                    </span>

                </a>


                <!-- CART -->
                <a class="header-icon"
                   href="@Url.Action("Index", "Cart")"
                   aria-label="Giỏ hàng">

                    <i class="fa-solid fa-bag-shopping"></i>

                    <span class="cart-number"
                          id="cartNumber">
                        0
                    </span>

                </a>

            </nav>

        </div>

    </header>



    <!-- MOBILE MENU -->
    <nav class="mobile-menu"
         id="mobileMenu">

        <a href="@Url.Action("Index", "Home")">
            TRANG CHỦ
        </a>

        <a href="@Url.Action("Index", "Products")">
            TẤT CẢ TÚI
        </a>

        <a href="@Url.Action("Index", "Cart")">
            GIỎ HÀNG
        </a>

    </nav>



    <!-- MAIN -->
    <main class="page-shell detail-shell">


        <!-- BREADCRUMB -->
        <div class="service-breadcrumb">

            <a href="@Url.Action("Index", "Home")">
                Trang chủ
            </a>

            <span>/</span>

            <a href="@Url.Action("Index", "Products")">
                Tất cả sản phẩm
            </a>

            <span>/</span>

            <span>
                Chi tiết
            </span>

        </div>



        <!-- PRODUCT DETAIL -->
        <div id="detail"
             class="product-detail-page">
        </div>



        <!-- REVIEWS -->
        <section class="detail-reviews-section"
                 id="reviews">


            <!-- REVIEW HEADING -->
            <div class="review-section-heading">

                <div>

                    <span class="eyebrow">
                        CUSTOMER NOTES
                    </span>

                    <h2>
                        Khách hàng nói gì
                    </h2>

                </div>


                <div class="review-rating-summary"
                     id="reviewSummary">
                </div>

            </div>



            <!-- REVIEW LIST -->
            <div id="reviewList"
                 class="customer-review-list"
                 aria-live="polite">
            </div>



            <!-- REVIEW FORM -->
            <form id="reviewForm"
                  class="customer-review-form">


                <h3>
                    Chia sẻ trải nghiệm của bạn
                </h3>



                <!-- RATING -->
                <label for="reviewRating">
                    Đánh giá
                </label>


                <select id="reviewRating"
                        name="rating"
                        required>

                    <option value="5">
                        ★★★★★ · Tuyệt vời
                    </option>

                    <option value="4">
                        ★★★★☆ · Rất tốt
                    </option>

                    <option value="3">
                        ★★★☆☆ · Tốt
                    </option>

                    <option value="2">
                        ★★☆☆☆ · Cần cải thiện
                    </option>

                    <option value="1">
                        ★☆☆☆☆ · Chưa hài lòng
                    </option>

                </select>



                <!-- REVIEW TEXT -->
                <label for="reviewText">
                    Nhận xét
                </label>


                <textarea id="reviewText"
                          name="text"
                          rows="4"
                          maxlength="500"
                          required
                          placeholder="Chia sẻ cảm nhận về chiếc túi bạn đã trải nghiệm..."></textarea>



                <!-- SUBMIT -->
                <button class="ui-btn"
                        type="submit">

                    GỬI ĐÁNH GIÁ

                    <i class="fa-solid fa-arrow-right"></i>

                </button>



                <small class="demo-disclaimer">
                    Đánh giá được lưu cục bộ trên trình duyệt
                    để thử giao diện.
                </small>

            </form>

        </section>

    </main>



    <!-- FOOTER -->
    <footer class="storefront-footer">

        <div class="footer-bottom">

            <a href="@Url.Action("Index", "Products")">
                ← TIẾP TỤC KHÁM PHÁ
            </a>

            <span>
                © 2026 MAISONÉ
            </span>

        </div>

    </footer>



    <!-- TOAST -->
    <div id="toast"
         class="toast"
         role="status"
         aria-live="polite">
    </div>



    <!-- JAVASCRIPT -->
    <!-- JAVASCRIPT -->

    <script>
    window.mvcRoot = '@Url.Content("~/Content/")';
    </script>

    <script src="@Url.Content("~/Scripts/Java/data.js")"></script>

    <script src="@Url.Content("~/Scripts/Java/common.js")"></script>

    <script src="@Url.Content("~/Scripts/Java/detail.js")"></script>

</body>

</html>