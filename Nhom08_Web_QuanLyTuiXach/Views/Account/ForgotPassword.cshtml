@{
    ViewBag.Title = "Quên mật khẩu · MAISONÉ";
}

<!doctype html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Quên mật khẩu · MAISONÉ</title>


    <!-- GOOGLE FONT -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
          rel="stylesheet">


    <!-- FONT AWESOME -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <!-- CSS -->
    <link rel="stylesheet"
          href="~/Content/css/style.css">

</head>


<body class="account-auth-page">


    <!-- ANNOUNCEMENT -->
    <div class="announcement">

        MAISONÉ · KHÔI PHỤC TÀI KHOẢN CỦA BẠN

    </div>



    <!-- HEADER -->
    <header class="header">

        <div class="header-inner">


            <!-- LEFT NAV -->
            <nav class="left-nav">

                <a class="nav-link"
                   href="@Url.Action("Index", "Home")">

                    TRANG CHỦ

                </a>


                <a class="nav-link"
                   href="@Url.Action("Index", "Products")">

                    SẢN PHẨM

                </a>

            </nav>



            <!-- MOBILE BUTTON -->
            <button class="mobile-button"
                    type="button"
                    onclick="toggleMobileMenu()"
                    aria-label="Mở menu">

                <i class="fa-solid fa-bars"></i>

            </button>



            <!-- LOGO -->
            <a class="logo"
               href="@Url.Action("Index", "Home")">

                MAISONÉ

                <span class="logo-sub">
                    BAGS & ACCESSORIES
                </span>

            </a>



            <!-- RIGHT NAV -->
            <nav class="right-nav">

                <a class="header-icon"
                   href="@Url.Action("Index", "Cart")"
                   aria-label="Giỏ hàng">

                    <i class="fa-solid fa-bag-shopping"></i>

                    <span class="cart-number"
                          id="cartNumber">

                        0

                    </span>

                </a>

            </nav>


        </div>

    </header>



    <!-- MOBILE MENU -->
    <nav class="mobile-menu"
         id="mobileMenu">

        <a href="@Url.Action("Index", "Home")">
            TRANG CHỦ
        </a>

        <a href="@Url.Action("Index", "Products")">
            SẢN PHẨM
        </a>

        <a href="@Url.Action("Index", "Cart")">
            GIỎ HÀNG
        </a>

    </nav>



    <!-- MAIN -->
    <main class="auth-page">


        <section class="auth-box auth-box-redesigned">


            <div class="auth-form">


                <!-- EYEBROW -->
                <span class="eyebrow">

                    RESET YOUR PASSWORD

                </span>



                <!-- TITLE -->
                <h1 class="page-title">

                    Khôi phục
                    <br>

                    <em>mật khẩu.</em>

                </h1>



                <!-- DESCRIPTION -->
                <p class="account-subtitle">

                    Nhập email đã đăng ký và tạo mật khẩu mới
                    cho tài khoản của bạn.

                </p>



                <!-- FORM -->
                <form id="forgotForm"
                      class="account-form">


                    <!-- EMAIL -->
                    <div class="account-field">

                        <label for="email">
                            Email đã đăng ký
                        </label>

                        <input class="ui-input"
                               id="email"
                               name="email"
                               type="email"
                               autocomplete="email"
                               required
                               placeholder="ban@email.com">

                    </div>



                    <!-- NEW PASSWORD -->
                    <div class="account-field">

                        <label for="newPassword">

                            Mật khẩu mới

                            <small>
                                (ít nhất 6 ký tự)
                            </small>

                        </label>

                        <input class="ui-input"
                               id="newPassword"
                               name="newPassword"
                               type="password"
                               autocomplete="new-password"
                               minlength="6"
                               required
                               placeholder="Nhập mật khẩu mới">

                    </div>



                    <!-- CONFIRM PASSWORD -->
                    <div class="account-field">

                        <label for="confirmPassword">

                            Nhập lại mật khẩu mới

                        </label>

                        <input class="ui-input"
                               id="confirmPassword"
                               name="confirmPassword"
                               type="password"
                               autocomplete="new-password"
                               minlength="6"
                               required
                               placeholder="Xác nhận mật khẩu mới">

                    </div>



                    <!-- SUBMIT -->
                    <button class="ui-btn auth-submit"
                            type="submit">

                        CẬP NHẬT MẬT KHẨU

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>


                </form>



                <!-- BACK LOGIN -->
                <p class="auth-switch">

                    <a class="link"
                       href="@Url.Action("Login", "Account")">

                        <i class="fa-solid fa-arrow-left"></i>

                        Quay lại đăng nhập

                    </a>

                </p>



                <!-- DISCLAIMER -->
                <p class="demo-disclaimer">

                    Bản demo cập nhật mật khẩu cục bộ trên trình duyệt;
                    không gửi email xác minh.

                </p>


            </div>

        </section>

    </main>



    <!-- TOAST -->
    <div id="toast"
         class="toast"
         role="status"
         aria-live="polite">
    </div>



    <!-- JAVASCRIPT -->
    <script>

        // Đường dẫn MVC để forgot.js redirect về trang đăng nhập
        window.mvcLoginUrl = '@Url.Action("Login", "Account")';

    </script>

    <script src="~/Scripts/Java/data.js"></script>

    <script src="~/Scripts/Java/common.js"></script>

    <script src="~/Scripts/Java/forgot-password.js"></script>


</body>

</html>