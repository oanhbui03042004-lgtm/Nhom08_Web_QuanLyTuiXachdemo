@{
    ViewBag.Title = "Tổng quan · MAISONÉ Admin";
}

<!doctype html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width,initial-scale=1">

    <link rel="stylesheet"
          href="~/Content/css/style.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <title>Tổng quan · MAISONÉ Admin</title>

</head>


<body class="admin-body">

    <div class="admin-app">


        <!-- SIDEBAR -->
        <aside class="admin-sidebar">

            <div class="admin-brand">
                MAISONÉ
                <small>ADMIN CONSOLE</small>
            </div>


            <div class="admin-user">

                <i class="fa-solid fa-circle-user"></i>

                <div>

                    <b data-admin-name>
                        System Admin
                    </b>

                    <span data-admin-role>
                        Quản trị hệ thống
                    </span>

                </div>

            </div>


            <!-- MENU -->
            <nav>

                <!-- TỔNG QUAN -->
                <a class="active"
                   href="@Url.Action("Index", "Admin")">

                    <i class="fa-solid fa-gauge-high"></i>

                    Tổng quan

                </a>


                <!-- SẢN PHẨM -->
                <a href="@Url.Action("Products", "Admin")"
                   data-permission="products">

                    <i class="fa-solid fa-bag-shopping"></i>

                    Sản phẩm

                </a>


                <!-- ĐƠN HÀNG -->
                <a href="@Url.Action("Orders", "Admin")"
                   data-permission="orders">

                    <i class="fa-solid fa-receipt"></i>

                    Đơn hàng & tài chính

                </a>


                <!-- KHO -->
                <a href="@Url.Action("Inventory", "Admin")"
                   data-permission="inventory">

                    <i class="fa-solid fa-boxes-stacked"></i>

                    Kho hàng

                </a>


                <!-- KHÁCH HÀNG -->
                <a href="@Url.Action("Customers", "Admin")"
                   data-permission="customers">

                    <i class="fa-solid fa-users"></i>

                    Khách hàng

                </a>


                <!-- VOUCHER -->
                <a href="@Url.Action("Marketing", "Admin")"
                   data-permission="vouchers">

                    <i class="fa-solid fa-ticket"></i>

                    Voucher

                </a>


                <!-- NHÂN SỰ -->
                <a href="@Url.Action("Staff", "Admin")#personnel"
                   data-permission="staff">

                    <i class="fa-solid fa-users-gear"></i>

                    Nhân sự

                </a>


                <!-- LỊCH LÀM -->
                <a href="@Url.Action("Staff", "Admin")#schedule"
                   data-permission="staff">

                    <i class="fa-solid fa-calendar-days"></i>

                    Lịch làm

                </a>


                <!-- THEO DÕI VẬN ĐƠN -->
                <a href="@Url.Action("Shipping", "Admin")"
                   data-permission="tracking">

                    <i class="fa-solid fa-truck-fast"></i>

                    Theo dõi vận đơn

                </a>

            </nav>


            <!-- SIDEBAR BOTTOM -->
            <div class="admin-sidebar-bottom">


                <a href="@Url.Action("Index", "Home")">

                    <i class="fa-solid fa-store"></i>

                    Xem website

                </a>


                <a href="@Url.Action("Index", "Home")"
                   data-logout>

                    <i class="fa-solid fa-right-from-bracket"></i>

                    Đăng xuất

                </a>

            </div>

        </aside>



        <!-- MAIN -->
        <main class="admin-main">


            <!-- TOPBAR -->
            <header class="admin-topbar">

                <div>

                    <span class="admin-breadcrumb">
                        MAISONÉ / ADMIN
                    </span>

                    <h1>
                        Tổng quan kinh doanh
                    </h1>

                </div>


                <div class="admin-top-actions">

                    <span class="admin-avatar">
                        A
                    </span>

                </div>

            </header>



            <!-- CONTENT -->
            <section class="admin-content">


                <!-- OVERVIEW HEADER -->
                <div class="collection-head dashboard-overview">


                    <div class="dashboard-overview-copy">

                        <span class="dashboard-overview-kicker">

                            <i class="fa-solid fa-chart-line"></i>

                            BUSINESS OVERVIEW

                        </span>


                        <h1 class="page-title">
                            Tổng quan doanh thu
                        </h1>


                        <p>
                            Theo dõi hiệu quả kinh doanh và tra cứu
                            doanh thu theo từng ngày, tháng hoặc năm.
                        </p>

                    </div>



                    <!-- FILTER -->
                    <div class="dashboard-filters">


                        <!-- PERIOD -->
                        <div class="dashboard-mode-field">

                            <span class="dashboard-field-label">
                                Thống kê theo
                            </span>


                            <span class="dashboard-control dashboard-mode-control">

                                <i class="fa-solid fa-chart-column"></i>


                                <button class="dashboard-period-trigger"
                                        id="dashboardPeriodTrigger"
                                        type="button"
                                        aria-haspopup="menu"
                                        aria-expanded="false">

                                    Tháng

                                    <i class="fa-solid fa-chevron-down dashboard-select-chevron"></i>

                                </button>


                                <select id="dashboardPeriod"
                                        class="dashboard-period-native"
                                        aria-hidden="true"
                                        tabindex="-1">

                                    <option value="day">
                                        Ngày
                                    </option>

                                    <option value="month" selected>
                                        Tháng
                                    </option>

                                    <option value="year">
                                        Năm
                                    </option>

                                </select>


                                <!-- PERIOD MENU -->
                                <div class="dashboard-period-menu"
                                     id="dashboardPeriodMenu"
                                     role="menu"
                                     aria-label="Chọn kỳ thống kê"
                                     hidden>


                                    <button type="button"
                                            role="menuitemradio"
                                            aria-checked="false"
                                            data-period="day">

                                        <i class="fa-regular fa-calendar"></i>

                                        <span>
                                            Ngày
                                        </span>

                                        <small>
                                            Xem theo từng khung giờ
                                        </small>

                                    </button>


                                    <button type="button"
                                            role="menuitemradio"
                                            aria-checked="true"
                                            data-period="month">

                                        <i class="fa-regular fa-calendar-days"></i>

                                        <span>
                                            Tháng
                                        </span>

                                        <small>
                                            So sánh doanh thu từng ngày
                                        </small>

                                    </button>


                                    <button type="button"
                                            role="menuitemradio"
                                            aria-checked="false"
                                            data-period="year">

                                        <i class="fa-regular fa-calendar-check"></i>

                                        <span>
                                            Năm
                                        </span>

                                        <small>
                                            Tổng hợp theo từng tháng
                                        </small>

                                    </button>

                                </div>

                            </span>

                        </div>



                        <!-- DAY -->
                        <div id="dashboardDayField"
                             class="dashboard-date-field">

                            <span class="dashboard-field-label">
                                Chọn ngày
                            </span>


                            <span class="dashboard-control dashboard-date-control">

                                <i class="fa-regular fa-calendar"></i>


                                <button class="dashboard-picker-trigger"
                                        id="dashboardDayTrigger"
                                        type="button"
                                        aria-haspopup="dialog"
                                        aria-expanded="false">
                                </button>

                            </span>


                            <input id="dashboardDay"
                                   type="hidden">


                            <div class="dashboard-calendar-popover"
                                 id="dashboardDayPicker"
                                 role="dialog"
                                 aria-label="Chọn ngày thống kê"
                                 hidden>
                            </div>

                        </div>



                        <!-- MONTH -->
                        <div id="dashboardMonthField"
                             class="dashboard-date-field"
                             hidden>

                            <span class="dashboard-field-label">
                                Chọn tháng
                            </span>


                            <span class="dashboard-control dashboard-date-control">

                                <i class="fa-regular fa-calendar"></i>


                                <button class="dashboard-picker-trigger"
                                        id="dashboardMonthTrigger"
                                        type="button"
                                        aria-haspopup="dialog"
                                        aria-expanded="false">
                                </button>

                            </span>


                            <input id="dashboardMonth"
                                   type="hidden">


                            <div class="dashboard-calendar-popover month-picker-popover"
                                 id="dashboardMonthPicker"
                                 role="dialog"
                                 aria-label="Chọn tháng thống kê"
                                 hidden>
                            </div>

                        </div>



                        <!-- YEAR -->
                        <label id="dashboardYearField"
                               class="dashboard-date-field"
                               hidden>

                            <span class="dashboard-field-label">
                                Chọn năm
                            </span>


                            <span class="dashboard-control">

                                <i class="fa-regular fa-calendar"></i>


                                <select id="dashboardYear"
                                        aria-label="Chọn năm thống kê"
                                        required>
                                </select>

                            </span>

                        </label>

                    </div>

                </div>



                <!-- STATS -->
                <div class="stats">


                    <div class="stat">

                        <small>
                            DOANH THU ĐÃ HOÀN TẤT
                        </small>

                        <b id="dashboardRevenue">
                            0đ
                        </b>

                        <span id="dashboardRevenuePeriod">
                            Trong kỳ đã chọn
                        </span>

                    </div>


                    <div class="stat">

                        <small>
                            ĐƠN ĐÃ ĐẶT
                        </small>

                        <b id="dashboardOrders">
                            0
                        </b>

                        <span>
                            Trong kỳ đã chọn
                        </span>

                    </div>


                    <div class="stat">

                        <small>
                            GIÁ TRỊ ĐƠN TRUNG BÌNH
                        </small>

                        <b id="dashboardAverage">
                            0đ
                        </b>

                        <span>
                            Chỉ tính đơn đã giao thành công
                        </span>

                    </div>


                    <div class="stat">

                        <small>
                            ĐANG CHỜ XỬ LÝ
                        </small>

                        <b id="dashboardPending">
                            0
                        </b>

                        <span>
                            Trên toàn bộ đơn hàng
                        </span>

                    </div>

                </div>



                <!-- CHART -->
                <section class="ui-card dashboard-chart-card">


                    <div class="dashboard-chart-heading">


                        <div>

                            <span class="eyebrow">
                                SALES PERFORMANCE
                            </span>


                            <h2 id="dashboardChartTitle">
                                Doanh thu theo ngày
                            </h2>


                            <p id="dashboardChartDescription">
                                Trục dọc là doanh thu;
                                mỗi cột là một khoảng thời gian.
                            </p>

                        </div>


                        <span class="dashboard-chart-legend">

                            <i></i>

                            Doanh thu hoàn tất

                        </span>

                    </div>



                    <div class="dashboard-chart-scroll">

                        <svg class="dashboard-chart"
                             id="dashboardChart"
                             role="img"
                             aria-label="Biểu đồ cột doanh thu">
                        </svg>

                    </div>


                    <div class="dashboard-axis-caption">

                        <span id="dashboardAxisLabel">
                            Doanh thu (VNĐ)
                        </span>

                        <span>
                            Thời gian trong kỳ đã chọn
                        </span>

                    </div>

                </section>



                <!-- REVENUE HISTORY -->
                <section class="ui-card dashboard-history-card">


                    <div class="admin-section-heading">


                        <div>

                            <span class="eyebrow">
                                REVENUE HISTORY
                            </span>


                            <h2>
                                Lịch sử doanh thu
                            </h2>


                            <p>
                                Bảng phân kỳ doanh thu đơn đã giao;
                                dùng bộ lọc phía trên để tra ngày,
                                tháng hoặc năm.
                            </p>

                        </div>


                        <a class="text-link"
                           href="@Url.Action("Orders", "Admin")">

                            CHI TIẾT ĐƠN →

                        </a>

                    </div>



                    <div class="admin-table-scroll">

                        <table class="data-table">


                            <thead>

                                <tr>

                                    <th>
                                        Kỳ
                                    </th>

                                    <th>
                                        Đơn đã đặt
                                    </th>

                                    <th>
                                        Đơn hoàn tất
                                    </th>

                                    <th>
                                        Doanh thu
                                    </th>

                                </tr>

                            </thead>


                            <tbody id="dashboardHistory">
                            </tbody>

                        </table>

                    </div>


                    <p id="dashboardHistoryEmpty"
                       class="admin-empty-state"
                       hidden>

                        Chưa có đơn hàng trong kỳ đã chọn.

                    </p>

                </section>



                <!-- QUICK LINKS -->
                <div class="dashboard-quick-links">


                    <!-- ORDERS -->
                    <a class="ui-card"
                       href="@Url.Action("Orders", "Admin")">

                        <b>
                            Đơn hàng & tài chính
                        </b>

                        <span>
                            Xem đơn và tải báo cáo CSV
                        </span>

                    </a>



                    <!-- INVENTORY -->
                    <a class="ui-card"
                       href="@Url.Action("Inventory", "Admin")">

                        <b>
                            Nhập hàng vào kho
                        </b>

                        <span>
                            Tạo phiếu nhập và cập nhật tồn
                        </span>

                    </a>



                    <!-- STAFF -->
                    <a class="ui-card"
                       href="@Url.Action("Staff", "Admin")#personnel"
                       data-permission="staff">

                        <b>
                            Nhân sự
                        </b>

                        <span>
                            Hồ sơ, tìm kiếm và nghỉ phép
                        </span>

                    </a>



                    <!-- SCHEDULE -->
                    <a class="ui-card"
                       href="@Url.Action("Staff", "Admin")#schedule"
                       data-permission="staff">

                        <b>
                            Lịch làm
                        </b>

                        <span>
                            Phân lịch, chấm công và ca trống
                        </span>

                    </a>

                </div>

            </section>

        </main>

    </div>



    <!-- TOAST -->
    <div id="toast"
         class="toast"
         role="status"
         aria-live="polite">
    </div>



    <!-- JAVASCRIPT -->
    <script src="~/Scripts/Java/data.js"></script>

    <script src="~/Scripts/Java/common.js"></script>

    <script src="~/Scripts/Java/form-select.js"></script>

    <script src="~/Scripts/Java/admin-dashboard.js"></script>


</body>
</html>